{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ad_pipeline.schema.json",
  "title": "AdProject",
  "description": "15초 광고 생성 파이프라인의 단계별 데이터. ad_storyboards 벤치마크(manifest.json + storyline.md)를 역설계해 만들었고, 벤치마크에서는 산문 안에만 있던 정보를 별도 필드로 뺐다. 각 단계는 앞 단계 산출물만 읽는다.",
  "type": "object",
  "required": ["id", "brief", "strategy", "cast", "scenes", "render"],
  "properties": {
    "id": { "type": "string", "description": "폴더명과 같은 값. 예: 01_thermos, 12_hera_b" },
    "variant": {
      "type": "object",
      "description": "같은 기획을 그림 설정만 바꿔 다시 생성할 때 쓴다. 벤치마크의 키비주얼 A/B는 스토리라인이 같고 키프레임 해상도와 스타일만 다르다.",
      "properties": {
        "group_id": { "type": "string", "description": "같은 기획을 공유하는 묶음. 예: hera" },
        "label": { "type": "string", "description": "예: A, B" }
      }
    },

    "brief": {
      "description": "[0단계 입력] 사람이 주거나 상품 DB에서 가져오는 값",
      "type": "object",
      "required": ["brand", "product", "duration_sec"],
      "properties": {
        "brand": { "type": "string", "description": "manifest.brand" },
        "product": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "description": "정식 제품명" },
            "category": { "type": "string", "description": "음료, 화장품, 식품, 금융 등. 문구 심의 규칙을 고를 때 쓴다" },
            "description": { "type": "string", "description": "manifest.product의 '—' 뒤 설명" },
            "visual_identifiers": {
              "type": "array", "items": { "type": "string" },
              "description": "생성 이미지에서 반드시 지켜야 할 외형. 예: 크림색, 초록 캔, 노란 통, 은색 메탈 카드"
            },
            "reference_images": {
              "type": "array",
              "description": "manifest.products. 키프레임 생성의 레퍼런스로 쓴다",
              "items": {
                "type": "object",
                "required": ["file", "view"],
                "properties": {
                  "id": { "type": "string" },
                  "file": { "type": "string" },
                  "view": { "type": "string", "description": "manifest.products[].label. 예: 정면, 뚜껑 연 모습, 조리 모습, 로고" },
                  "kind": { "enum": ["packshot", "in_use", "detail", "logo", "variant_lineup"] }
                }
              }
            }
          }
        },
        "duration_sec": { "type": "number", "default": 15 },
        "target_audience": { "type": "string" },
        "mandatory_copy": { "type": "string", "description": "광고주가 정해 준 카피가 있으면 넣는다" },
        "claim_constraints": {
          "type": "array", "items": { "type": "string" },
          "description": "쓰면 안 되거나 심의된 표현만 써야 하는 문구. 예: 건강기능식품 기능성 표현"
        }
      }
    },

    "strategy": {
      "description": "[1단계 LLM] 크리에이티브 전략. storyline.md 상단 블록에 해당한다 (manifest에는 insight와 idea가 빠져 있다)",
      "type": "object",
      "required": ["title", "message", "insight", "idea", "device"],
      "properties": {
        "title": { "type": "string", "description": "manifest.name. 예: 얼음 퇴근 금지" },
        "message": { "type": "string", "description": "광고 메시지(슬로건과 브랜드명)" },
        "insight": { "type": "string", "description": "소비자가 겪는 상황이나 불편 한 문장" },
        "idea": { "type": "string", "description": "장점을 보여주는 장치 한 문장" },
        "device": {
          "enum": ["visual_transformation", "proof_by_evidence", "hybrid"],
          "description": "visual_transformation: 은유를 물리적 변화로 보여준다(01–06). proof_by_evidence: 비교나 누적으로 증명하고 제3자가 알아챈다(07–16). hybrid: 둘을 섞는다(17)"
        },
        "voice_mode": {
          "enum": ["narration", "dialogue_only", "mixed"],
          "description": "01–04는 나레이션 중심이고 05 이후는 현장음과 대사 한 줄이다"
        },
        "tone": {
          "type": "object",
          "properties": {
            "summary": { "type": "string", "description": "manifest.tone 원문" },
            "brightness": { "enum": ["bright", "mid", "dark"] },
            "color_arc": {
              "type": "array", "items": { "type": "string" },
              "description": "장면 순서대로 바뀌는 색. 예: [아침 청록, 오후 호박색, 밤 텅스텐]"
            }
          }
        }
      }
    },

    "cast": {
      "description": "[1–2단계] 인물 설정. 벤치마크에는 이 필드가 없고 '그녀', '빨간 패딩 친구', '민트색 소매' 같은 식으로 장면 산문 안에만 있다. 키프레임 8장에서 같은 인물로 보이게 하려면 별도로 빼야 한다",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "appearance"],
        "properties": {
          "id": { "type": "string", "description": "예: hero, friend, boss" },
          "role": { "enum": ["protagonist", "observer", "supporting", "extra"], "description": "observer는 proof 구조에서 의문형 대사를 하는 제3자" },
          "appearance": { "type": "string", "description": "나이대, 헤어, 체형" },
          "wardrobe": { "type": "string", "description": "예: 베이지 카디건, 빨간 패딩, 민트색 소매. 손만 나오는 컷의 연속성도 이 값에 의존한다" },
          "reference_image": { "type": "string" },
          "voice": { "type": "string", "description": "대사 TTS 보이스 ID" }
        }
      }
    },

    "scenes": {
      "description": "[2단계 LLM] 장면 목록. 벤치마크는 8개 고정이고 장면 배열은 문자열, 나레이션과 대사는 장면 번호를 키로 하는 dict로 따로 둔다. 파이프라인에서는 장면 객체 안으로 합치는 편이 다루기 쉽다",
      "type": "array",
      "minItems": 6, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["index", "description", "beat"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "beat": {
            "enum": ["setup", "product_intro", "product_use", "turn", "payoff", "reaction", "packshot"],
            "description": "벤치마크의 공통 배치: 1 setup, 2–3 product_intro/use, 4–5 turn, 6–7 payoff+대사, 8 packshot"
          },
          "description": { "type": "string", "description": "manifest.scenes[i] 원문(사람이 읽는 장면 설명)" },
          "duration_sec": { "type": "number", "description": "벤치마크에는 없다. 15초/8장면이면 평균 1.9초이고, 대사 장면은 2.5–3초가 필요하다" },

          "time_place": { "type": "string", "description": "예: 아침 8시 50분 · 창가 책상" },
          "shot": {
            "type": "object",
            "description": "산문에 섞여 있던 촬영 지시",
            "properties": {
              "size": { "enum": ["extreme_closeup", "closeup", "medium", "wide", "overhead", "insert"], "description": "접사, 클로즈업, 위에서 내려다본 등" },
              "camera_move": { "type": "string", "description": "예: 옆에서 나란히 따라감, 타임랩스" },
              "focus": { "type": "string", "description": "예: 주인공만 또렷, 배경 인물 흐릿" }
            }
          },
          "characters": { "type": "array", "items": { "type": "string" }, "description": "cast.id 목록" },
          "action": { "type": "string", "description": "장면당 동작 하나만 둔다(벤치마크의 일관된 원칙)" },
          "hands": {
            "type": "string",
            "description": "손 지정. 예: 왼손 스틱, 오른손이 뜯음 / 오른손 검지로 따개. AI 생성에서 손이 깨지지 않게 하려고 벤치마크가 반복해서 쓰는 지시"
          },
          "product": {
            "type": "object",
            "properties": {
              "visible": { "type": "boolean" },
              "state": { "type": "string", "description": "예: 뚜껑 닫힘, 개봉, 조리됨, 빈 스틱" },
              "reference_image_ids": { "type": "array", "items": { "type": "string" }, "description": "이 장면 키프레임에 넣을 brief.product.reference_images" }
            }
          },
          "vfx": { "type": "string", "description": "visual_transformation 장치. 예: 탄산 거품 물결이 지나간 자리가 선명해짐" },
          "lighting": { "type": "string", "description": "tone.color_arc 중 이 장면의 값" },
          "reaction_beat": { "type": "string", "description": "예: 어깨 으쓱 → 한 박자 뒤에 상대가 웃음" },

          "audio": {
            "type": "object",
            "properties": {
              "narration": { "type": ["string", "null"], "description": "manifest.narration[index]" },
              "dialogue": {
                "type": ["object", "null"],
                "description": "manifest.dialogue[index]. 벤치마크에는 화자 필드가 없다",
                "properties": {
                  "speaker": { "type": "string", "description": "cast.id" },
                  "line": { "type": "string" },
                  "type": { "enum": ["product_praise", "observer_question", "emotional"], "description": "'역시 ○○!' 류 / '…똑같네?' 류 / '엄마, 나 왔어!' 류" }
                }
              },
              "sfx": { "type": "array", "items": { "type": "string" }, "description": "예: 딸깍, 칙, 삑, 바삭, 얼음 부딪히는 소리" }
            }
          },
          "on_screen_text": { "type": ["string", "null"], "description": "자막이나 엔드카드 카피. 벤치마크에는 없다. 나레이션이 없는 광고는 메시지를 여기에 실어야 한다" },

          "keyframe": {
            "type": "object",
            "description": "[3단계 이미지 생성] 산출물",
            "properties": {
              "file": { "type": "string", "description": "keyframes/scene_XX.jpg" },
              "prompt": { "type": "string", "description": "위 구조화 필드를 합성한 실제 생성 프롬프트. 벤치마크에는 없다" },
              "seed": { "type": ["integer", "null"] }
            }
          },
          "clip": {
            "type": "object",
            "description": "[4단계 영상 생성] 장면 단위로 생성할 때 쓴다",
            "properties": {
              "file": { "type": "string" },
              "motion_prompt": { "type": "string" },
              "start_frame": { "type": "string", "description": "keyframe.file" }
            }
          }
        }
      }
    },

    "render": {
      "description": "[3–5단계] 생성과 후반 설정. 벤치마크의 실측값을 default로 적었다",
      "type": "object",
      "properties": {
        "keyframe_model": { "type": "string" },
        "keyframe_size": { "type": "string", "examples": ["1312x736", "1536x864"], "description": "A=1312x736, B=1536x864 (16:9)" },
        "keyframe_style": { "type": "string", "description": "variant가 바꾸는 값" },
        "video_model": { "type": "string" },
        "video_gen_size": { "type": "string", "default": "854x480" },
        "video_out_size": { "type": "string", "default": "1280x720", "description": "벤치마크는 단순 업스케일만 해서 실제 화질은 480p" },
        "fps": { "type": "number" },
        "music": { "type": "object", "properties": { "file": { "type": "string" }, "mood": { "type": "string" } } },
        "tts": { "type": "object", "properties": { "narrator_voice": { "type": "string" } } }
      }
    },

    "outputs": {
      "description": "[5단계] 최종 산출물. manifest의 video, seconds, keyframes, storyline에 해당",
      "type": "object",
      "properties": {
        "video": { "type": "string" },
        "seconds": { "type": "number" },
        "storyline_md": { "type": "string" }
      }
    },

    "evaluation": {
      "description": "[6단계] 평가. 벤치마크 페이지 제목이 '평가 데이터'인데 점수 필드는 공개돼 있지 않다. 비교 실험을 하려면 직접 정의해야 한다",
      "type": "object",
      "properties": {
        "product_fidelity": { "type": "number", "description": "레퍼런스와 비교한 제품 외형 일치도" },
        "character_consistency": { "type": "number" },
        "message_clarity": { "type": "number", "description": "나레이션이나 자막 없이도 메시지가 전달되는지" },
        "artifact_issues": { "type": "array", "items": { "type": "string" }, "description": "손, 글자, 로고 깨짐 등" },
        "claim_risk": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
